# deploy/langfuse/.env şablonu — gerçek değerleri üretmek için:
#   cd deploy/langfuse
#   for v in POSTGRES_PASSWORD CLICKHOUSE_PASSWORD REDIS_PASSWORD MINIO_ROOT_PASSWORD \
#            SALT NEXTAUTH_SECRET LANGFUSE_INIT_USER_PASSWORD; do
#     echo "$v=$(openssl rand -hex 32)"; done > .env
#   echo "ENCRYPTION_KEY=$(openssl rand -hex 32)" >> .env   # 64 hex karakter ZORUNLU
#   echo "LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-$(uuidgen)" >> .env
#   echo "LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-$(uuidgen)" >> .env
#
# pk/sk anahtarları headless init ile ilk açılışta projeye yazılır; AYNI
# değerler repo kökündeki .env'e LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY
# olarak kopyalanır (SDK oradan okur).
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_PASSWORD=
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
