# =============================================================================
# RAG Donanım ve OCR Yapılandırması
# =============================================================================

# Hangi OCR motorunun kullanılacağı
# Seçenekler: "easyocr", "tesseract", "mac" (sadece macOS)
OCR_ENGINE=easyocr

# EasyOCR için GPU kullanılsın mı?
# Seçenekler: 
#   - auto  (GPU varsa otomatik kullanır, yoksa CPU'ya döner)
#   - true  (GPU kullanımını zorlar)
#   - false (CPU kullanımını zorlar)
DOCLING_USE_GPU=auto

# Late Chunking özelliğini aktif et (1 veya 0)
USE_LOCAL_LATE_CHUNKING=0

# PDF sayfa render çözünürlük ölçeği (Docling layout + okuma-sırası + OCR girdisi).
# 1.0 (~72 DPI) layout etiketleme ve çok-sütun okuma sırasını bozar; 2.0 (~144 DPI)
# belirgin iyileştirir (running-head'in doğru etiketlenmesi dahil). DİKKAT: parse
# cache anahtarının parçası — değiştirmek tüm korpus için yeniden-parse tetikler.
DOCLING_IMAGES_SCALE=2.0

# Docling layout modeli: heron (varsayılan, hızlı) | egret_large | egret_xlarge
# (daha doğru sütun/etiket, daha yavaş + büyük model indirmesi). Yeniden-parse gerektirir.
# DOCLING_LAYOUT_MODEL=heron

# =============================================================================
# Sayfa-düzeyi yönlendirici — taranmış sayfalar için tam-sayfa PaddleOCR-VL (:8080)
# =============================================================================
# Açıkken, native (çıkarılabilir) metni eşiğin altında kalan (taranmış) sayfalar
# Docling+EasyOCR yerine tam-sayfa PaddleOCR-VL pipeline'ına yönlenir (holistik
# layout + okuma sırası + oto-deskew; üst/alt bilgi ve sayfa-no gürültüsünü temiz
# eler). Digital-born sayfalar Docling'de kalır. :8080 servisi ayakta olmalı;
# erişilemezse fail-safe Docling atomları korunur. Etkinleştir: SCANNED_PAGE_OCR=1
SCANNED_PAGE_OCR=0
PADDLE_PAGE_OCR_URL=http://10.20.24.16:8080
# PADDLE_PAGE_TIMEOUT=180
# SCANNED_PAGE_CHAR_THRESHOLD=100
# SCANNED_PAGE_RENDER_ZOOM=2.0

# =============================================================================
# VLM Tablo Çıkarımı (taranmış/döndürülmüş tablolar)
# =============================================================================
# Docling'in okuyamadığı (TableFormer yapı çıkaramayan / OCR çöp üreten) taranmış,
# döndürülmüş tabloları yerel Ollama görü-dil modeliyle okur. Yalnızca "bozuk"
# tablolarda otomatik devreye girer; düzgün tablolara dokunmaz.
# Kapatmak için: VLM_TABLE_EXTRACTION=0
VLM_TABLE_EXTRACTION=1

# Ollama'da kurulu görü-dil modeli (7b hızlı+doğru; daha yüksek doğruluk için qwen2.5vl:32b)
VLM_TABLE_MODEL=qwen2.5vl:7b

# Kırpılan tablo görselini VLM'e vermeden önce Tesseract OSD ile dik çevir (1/0)
VLM_TABLE_AUTOROTATE=1

# Paralel bant gönderimleri (--band modunda kaç bant eşzamanlı gönderilsin)
# Gerçek hız kazanımı için Ollama'nın OLLAMA_NUM_PARALLEL değeri bu sayıya eşit
# veya büyük olmalı: OLLAMA_NUM_PARALLEL=5 ollama serve
VLM_TABLE_MAX_WORKERS=5

# (İsteğe bağlı) İnce ayar: render ölçeği, bağlam/üretim limitleri, bantlama eşikleri
# VLM_TABLE_ZOOM=3.0
# VLM_TABLE_NUM_CTX=32768
# VLM_TABLE_NUM_PREDICT=8192
# VLM_TABLE_TIMEOUT=900
# VLM_TABLE_TILE_MAX_HEIGHT_PX=1400

# =============================================================================
# Langfuse Gözlemlenebilirlik (yerel, self-hosted — deploy/langfuse/)
# =============================================================================
# 1 = trace gönder; 0 = tamamen kapalı (SDK nesnesi hiç yaratılmaz)
LANGFUSE_ENABLED=0
LANGFUSE_BASE_URL=http://localhost:3100
# Anahtarlar deploy/langfuse/.env'deki LANGFUSE_INIT_PROJECT_* değerleriyle
# AYNI olmalı (headless init o değerleri projeye yazar).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_SAMPLE_RATE=1.0
